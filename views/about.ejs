<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>About Doodlebook — The Infinite Sketchbook</title>
  <meta name="description" content="Learn the story behind Doodlebook, explore our handcrafted stationery tools guide, and discover tips for group drawing sessions.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Nunito:wght@400;500;600;700;800;900&family=Patrick+Hand&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="doodlebook-about">

  <!-- Top Navbar -->
  <header class="top-navbar">
    <div class="doodle-container nav-inner">
      <a href="/" class="brand-cluster" aria-label="Doodlebook home">
        <span class="brand-logo">
          doodlebook<span class="brand-dot">.</span>
          <span class="brand-doodle-spark">✨</span>
        </span>
      </a>

      <nav aria-label="Primary Navigation">
        <ul class="nav-links">
          <li><a href="/" class="nav-link">Home</a></li>
          <li><a href="/#howItWorks" class="nav-link">How it works</a></li>
          <li><a href="/gallery" class="nav-link">Gallery</a></li>
          <li><a href="/about" class="nav-link active">About</a></li>
        </ul>
      </nav>

      <div class="nav-actions">
        <a href="/#createRoomSection" class="btn-sticker btn-coral btn-sm">
          <span>+ Create a Room</span>
        </a>
      </div>
    </div>
  </header>

  <div class="doodle-container" style="padding-top: 3rem; padding-bottom: 5rem;">

    <!-- About Story Header -->
    <div class="notebook-binder-frame" style="margin-bottom: 3.5rem;">
      <div class="spiral-rings-track">
        <div class="spiral-ring"></div>
        <div class="spiral-ring"></div>
        <div class="spiral-ring"></div>
        <div class="spiral-ring"></div>
        <div class="spiral-ring"></div>
      </div>

      <div class="washi-tape washi-coral tape-top-right"></div>

      <div style="max-width: 780px;">
        <span class="section-tag">✦ THE DOODLEBOOK PHILOSOPHY ✦</span>
        <h1 class="hero-title" style="font-size: 3.5rem; margin-bottom: 1.25rem;">
          One giant sketchbook. Passed around the table.
        </h1>

        <p style="font-size: 1.2rem; color: var(--text-secondary); line-height: 1.7; margin-bottom: 1.5rem;">
          Remember passing around a physical notebook in class, at a diner, or during a sleepover? Someone drew a cartoon cat, another person added sunglasses, someone wrote a funny quote, and by the end of the night the page was filled with memory-rich collaborative art.
        </p>

        <p style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.7;">
          <strong>Doodlebook</strong> brings that exact warmth into the digital world. No corporate project management frameworks, no sterile whiteboards, and no login barriers. Just you, your friends, and a shared blank sheet of creamy paper.
        </p>
      </div>
    </div>

    <!-- Stationery Tools Guide -->
    <div style="margin-bottom: 4rem;">
      <div class="section-head">
        <span class="section-tag">✦ STATIONERY GUIDE ✦</span>
        <h2 class="section-heading">Your digital pencil case</h2>
        <p class="section-desc">Each tool was tuned to feel like its physical counterpart on real notebook paper.</p>
      </div>

      <div class="features-grid">
        <div class="feature-notebook-card">
          <div class="feature-icon-bubble" style="background: var(--color-yellow);">✏️</div>
          <h3 class="feature-title">Pencil</h3>
          <p class="feature-desc">Fine, organic line with a dark graphite feel. Perfect for handwriting, intricate sketches, and light planning.</p>
        </div>

        <div class="feature-notebook-card">
          <div class="feature-icon-bubble" style="background: var(--color-coral); color: #fff;">🖌️</div>
          <h3 class="feature-title">Ink Brush</h3>
          <p class="feature-desc">Bold, smooth, rounded stroke with natural line thickness. Ideal for cartoon outlines and comic lettering.</p>
        </div>

        <div class="feature-notebook-card">
          <div class="feature-icon-bubble" style="background: var(--color-pink); color: #fff;">🖍️</div>
          <h3 class="feature-title">Pastel Highlighter</h3>
          <p class="feature-desc">Translucent marker with wide coverage. Colors effortlessly underneath or over strokes just like a real stationery highlighter.</p>
        </div>

        <div class="feature-notebook-card">
          <div class="feature-icon-bubble" style="background: var(--color-green); color: #fff;">🧹</div>
          <h3 class="feature-title">Eraser</h3>
          <p class="feature-desc">Clean precision eraser that lifts strokes off the paper without damaging the notebook grid.</p>
        </div>

        <div class="feature-notebook-card">
          <div class="feature-icon-bubble" style="background: var(--color-blue); color: #fff;">📐</div>
          <h3 class="feature-title">Geometric Shapes</h3>
          <p class="feature-desc">Straight lines, rectangles, circles, triangles, and doodle stars with rubber-band live preview.</p>
        </div>

        <div class="feature-notebook-card">
          <div class="feature-icon-bubble" style="background: var(--color-lavender);">🏷️</div>
          <h3 class="feature-title">Handwritten Text</h3>
          <p class="feature-desc">Drop handwritten text notes directly onto the canvas for speech bubbles, captions, and title cards.</p>
        </div>
      </div>
    </div>

    <!-- Keyboard Shortcuts Cheat Sheet -->
    <div class="scrapbook-card" style="max-width: 800px; margin: 0 auto 4rem;">
      <div class="washi-tape washi-blue tape-top-left"></div>
      <div class="card-stamp-badge" style="background: var(--color-blue-light); border-color: var(--color-blue); color: var(--color-blue);">
        <span>⌨️</span>
        <strong>SHORTCUTS CHEAT SHEET</strong>
      </div>

      <h3 class="card-title">Quick Keys for Power Doodlers</h3>
      <p class="card-desc">Keep your hand on the pen and switch tools seamlessly without interrupting your flow.</p>

      <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin-top: 1.5rem;">
        <div style="display: flex; align-items: center; justify-content: space-between; padding: 0.5rem 0.85rem; background: #FFFDF9; border: 1.5px solid var(--border-dark); border-radius: 8px;">
          <span>Pencil Tool</span>
          <kbd style="font-family: var(--font-mono); font-weight: 700; background: #E8F0FE; padding: 0.2rem 0.6rem; border-radius: 6px; border: 1px solid var(--color-blue);">P</kbd>
        </div>

        <div style="display: flex; align-items: center; justify-content: space-between; padding: 0.5rem 0.85rem; background: #FFFDF9; border: 1.5px solid var(--border-dark); border-radius: 8px;">
          <span>Brush Tool</span>
          <kbd style="font-family: var(--font-mono); font-weight: 700; background: #E8F0FE; padding: 0.2rem 0.6rem; border-radius: 6px; border: 1px solid var(--color-blue);">B</kbd>
        </div>

        <div style="display: flex; align-items: center; justify-content: space-between; padding: 0.5rem 0.85rem; background: #FFFDF9; border: 1.5px solid var(--border-dark); border-radius: 8px;">
          <span>Highlighter</span>
          <kbd style="font-family: var(--font-mono); font-weight: 700; background: #E8F0FE; padding: 0.2rem 0.6rem; border-radius: 6px; border: 1px solid var(--color-blue);">H</kbd>
        </div>

        <div style="display: flex; align-items: center; justify-content: space-between; padding: 0.5rem 0.85rem; background: #FFFDF9; border: 1.5px solid var(--border-dark); border-radius: 8px;">
          <span>Eraser Tool</span>
          <kbd style="font-family: var(--font-mono); font-weight: 700; background: #E8F0FE; padding: 0.2rem 0.6rem; border-radius: 6px; border: 1px solid var(--color-blue);">E</kbd>
        </div>

        <div style="display: flex; align-items: center; justify-content: space-between; padding: 0.5rem 0.85rem; background: #FFFDF9; border: 1.5px solid var(--border-dark); border-radius: 8px;">
          <span>Straight Line</span>
          <kbd style="font-family: var(--font-mono); font-weight: 700; background: #E8F0FE; padding: 0.2rem 0.6rem; border-radius: 6px; border: 1px solid var(--color-blue);">L</kbd>
        </div>

        <div style="display: flex; align-items: center; justify-content: space-between; padding: 0.5rem 0.85rem; background: #FFFDF9; border: 1.5px solid var(--border-dark); border-radius: 8px;">
          <span>Text Label</span>
          <kbd style="font-family: var(--font-mono); font-weight: 700; background: #E8F0FE; padding: 0.2rem 0.6rem; border-radius: 6px; border: 1px solid var(--color-blue);">T</kbd>
        </div>

        <div style="display: flex; align-items: center; justify-content: space-between; padding: 0.5rem 0.85rem; background: #FFFDF9; border: 1.5px solid var(--border-dark); border-radius: 8px;">
          <span>Undo Stroke</span>
          <kbd style="font-family: var(--font-mono); font-weight: 700; background: #E8F0FE; padding: 0.2rem 0.6rem; border-radius: 6px; border: 1px solid var(--color-blue);">Ctrl + Z</kbd>
        </div>

        <div style="display: flex; align-items: center; justify-content: space-between; padding: 0.5rem 0.85rem; background: #FFFDF9; border: 1.5px solid var(--border-dark); border-radius: 8px;">
          <span>Redo Stroke</span>
          <kbd style="font-family: var(--font-mono); font-weight: 700; background: #E8F0FE; padding: 0.2rem 0.6rem; border-radius: 6px; border: 1px solid var(--color-blue);">Ctrl + Y</kbd>
        </div>
      </div>
    </div>

    <!-- Final CTA -->
    <div style="text-align: center;">
      <a href="/#createRoomSection" class="btn-sticker btn-coral btn-lg">
        <span>+ Open a New Doodlebook Sheet →</span>
      </a>
    </div>

  </div>

  <!-- Footer -->
  <footer class="doodle-footer">
    <div class="doodle-container footer-inner">
      <div class="footer-brand">
        <span class="footer-logo">doodlebook<span style="color: var(--color-coral);">.</span></span>
        <span class="footer-tagline">Your friends. One notebook. Endless doodles.</span>
      </div>
      <div class="footer-links">
        <a href="/" class="footer-link">Home</a>
        <a href="/gallery" class="footer-link">Scrapbook Gallery</a>
        <a href="/about" class="footer-link">About</a>
      </div>
    </div>
  </footer>

</body>
</html>
